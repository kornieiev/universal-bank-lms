# Application
ENV_MODE=development
NODE_ENV=development
APP_PORT=5000
API_PREFIX=/api

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bank
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Auth
JWT_SECRET=replace_with_secure_random_value
JWT_EXPIRES_IN=3600
JWT_REFRESH_TOKEN_EXPIRES_IN=86400
JWT_AUDIENCE=UniversalBankFrontend
JWT_ISSUER=UniversalBankBackend

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookies
COOKIE_NAME=ub_access_token
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
